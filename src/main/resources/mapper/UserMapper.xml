<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.silenker.parkingrecommendation.mapper.UserMapper">

    <resultMap id="userResultMap" type="com.silenker.parkingrecommendation.model.entity.User">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="role" column="role"/>
    </resultMap>

    <select id="selectById" resultMap="userResultMap">
        SELECT * FROM users WHERE user_id = #{userId}
    </select>

    <select id="selectByUsername" resultMap="userResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <insert id="insert" parameterType="com.silenker.parkingrecommendation.model.entity.User">
        INSERT INTO users (user_id, username, password, role)
        VALUES (#{userId}, #{username}, #{password}, #{role})
    </insert>

    <update id="update" parameterType="com.silenker.parkingrecommendation.model.entity.User">
        UPDATE users SET username = #{username}, password = #{password}, role = #{role}
        WHERE user_id = #{userId}
    </update>
</mapper>
