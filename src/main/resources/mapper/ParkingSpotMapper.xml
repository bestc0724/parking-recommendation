<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.silenker.parkingrecommendation.mapper.ParkingSpotMapper">

    <resultMap id="spotResultMap" type="com.silenker.parkingrecommendation.model.entity.ParkingSpot">
        <id property="spotId" column="spot_id"/>
        <result property="heightLimit" column="height_limit"/>
        <result property="hasCharging" column="has_charging"/>
        <result property="spotType" column="spot_type"/>
        <result property="distanceToElevator" column="distance_to_elevator"/>
        <result property="pricePerHour" column="price_per_hour"/>
        <result property="status" column="status"/>
        <result property="version" column="version"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectAll" resultMap="spotResultMap">
        SELECT * FROM parking_spots
    </select>

    <select id="selectById" resultMap="spotResultMap">
        SELECT * FROM parking_spots WHERE spot_id = #{spotId}
    </select>

    <select id="selectByStatus" resultMap="spotResultMap">
        SELECT * FROM parking_spots WHERE status = #{status}
    </select>

    <select id="selectAvailable" resultMap="spotResultMap">
        SELECT * FROM parking_spots WHERE status = 'available'
    </select>

    <update id="updateStatus">
        UPDATE parking_spots SET status = #{status}, version = version + 1
        WHERE spot_id = #{spotId} AND version = #{expectedVersion}
    </update>

    <update id="updateStatusForce">
        UPDATE parking_spots SET status = #{status}, version = version + 1
        WHERE spot_id = #{spotId}
    </update>
</mapper>
