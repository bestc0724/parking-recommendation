# LLM 配置（OpenAI 兼容格式，使用 mimo API）
LLM_BASE_URL=your-LLM_MODEL
LLM_API_KEY=your-api-key
LLM_MODEL=mimo-v2.5-pro

# Java 后端地址
JAVA_BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=parking-internal-key-2024

# Qdrant 配置
QDRANT_HOST=192.168.100.128
QDRANT_PORT=6333
QDRANT_COLLECTION=parking_knowledge

# Agent 配置
AGENT_PORT=8001
SESSION_TTL_MINUTES=30
MAX_CHAT_HISTORY=20

# HuggingFace 镜像（国内网络必需，用于下载 Embedding 模型）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# Redis 会话存储（可选，留空则使用内存会话）
# REDIS_URL=redis://localhost:6379/0

# Langfuse 可观测性（可选，三项齐全才启用）
# 自托管或 Langfuse Cloud 均可：https://langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://localhost:3000
